{
  "name": "yediam-nene",
  "version": "0.1.0",
  "private": true,
  "description": "YEDIAM NENE — Plateforme mauritanienne de coordination du don de sang",
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:schema": "docker compose exec -T db psql -U yediam -d yediam < db/schema.sql",
    "api:install": "npm --prefix api install",
    "api:seed": "npm --prefix api run seed",
    "api:dev": "npm --prefix api run dev",
    "api:start": "npm --prefix api start",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  }
}